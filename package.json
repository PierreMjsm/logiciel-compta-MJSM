{
  "name": "compta-banque",
  "productName": "Compta Banque",
  "version": "1.6.0",
  "description": "Classement des relevés bancaires de l'ACEL Saint-Médard et des Jeunes de Saint-Médard, numéros de factures et export comptable.",
  "main": "main.js",
  "author": "ACEL Saint-Médard",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/tests.js",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.saintmedard.comptabanque",
    "productName": "Compta Banque",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json", "src/**/*", "renderer/**/*", "build/icon.png", "node_modules/**/*"],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "portable": { "artifactName": "Compta-Banque-${version}-portable.exe" },
    "nsis": {
      "artifactName": "Compta-Banque-${version}-installation.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Compta Banque"
    }
  }
}
